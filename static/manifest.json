{
  "manifest_version": 3,
  "name": "Bold Wallet",
  "version": "1.0.5",
  "version_name": "v1.0.5",
  "description": "Bold Bitcoin Wallet - Watch-only wallet with QR-based mobile signing",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://mempool.space/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; media-src 'self' blob:"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
